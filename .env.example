# =============================================================================
# Farukh Saifi Portfolio — Environment Variables
# Copy to .env.local for local development.
# Set these in Vercel (or .env.production) for production deployments.
# =============================================================================

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Public site URL (used for Spotify OAuth redirect, OG tags, RSS)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google Tag Manager + GA4 Google tag + Search Console
# Set these in Vercel → Project → Settings → Environment Variables (Production).
#
# GTM container (GTM-TZ7SLTFP) loads in <head>. Keep it for Tag Manager Preview.
#
# GA4 Measurement ID (required for Tag Assistant "Google tag" + window.gtag):
#   1. https://analytics.google.com → Admin → Data streams → Web → Measurement ID (G-XXXXXXXX)
#   2. Set NEXT_PUBLIC_GA_MEASUREMENT_ID below and in Vercel Production, then redeploy
#   3. Site loads gtag.js in SSR <head> with send_page_view:false (App Router sends page_view)
#   4. Do NOT also add a GA4 Configuration tag in GTM that sends page views (double-count)
#
# Search Console (indexing + ranking):
#   1. https://search.google.com/search-console → Add URL-prefix https://farukh.me
#   2. HTML tag verification → paste only the content="..." token below
#   3. Deploy, Verify, then submit sitemap https://farukh.me/sitemap.xml
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=GTM-TZ7SLTFP
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# Spotify (required for Now Playing)
# Create an app at https://developer.spotify.com/dashboard
# Redirect URIs (must match exactly in Dashboard → Settings):
#   Production: https://your-domain.com/spotify-success
#   Local:      http://127.0.0.1:3000/spotify-success  (localhost is rejected by Spotify)
# Optional override (exact Dashboard value):
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/spotify-success
# After OAuth, tokens are stored in MongoDB collection: spotify_credentials
# (shared music-service credentials; documents keyed by `service`)
# Optional: persist refresh token here so Now Playing can bootstrap if DB is empty
# -----------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
# SPOTIFY_REDIRECT_URI=

# -----------------------------------------------------------------------------
# YouTube Music (Google OAuth + YouTube Data API)
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3. Redirect URIs (must match exactly):
#   Production: https://your-domain.com/youtube-music-success
#   Local:      http://127.0.0.1:3000/youtube-music-success
# Optional override:
# YOUTUBE_MUSIC_REDIRECT_URI=http://127.0.0.1:3000/youtube-music-success
# Tokens: spotify_credentials (service=youtube_music) | last-played: music_last_played (service=youtube_music)
# -----------------------------------------------------------------------------
YOUTUBE_MUSIC_CLIENT_ID=
YOUTUBE_MUSIC_CLIENT_SECRET=
# YOUTUBE_MUSIC_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Apple Music (MusicKit on the Web)
# Create a MusicKit key at https://developer.apple.com/account/resources/authkeys/list
# (Keys → + → MusicKit). Download the .p8 private key once.
# MUSIC_KIT_TEAM_ID: Membership → Team ID
# MUSIC_KIT_KEY_ID: the Key ID shown for that MusicKit key
# MUSIC_KIT_PRIVATE_KEY: full PEM contents (use \n for newlines in a single line)
# MUSIC_KIT_ID: MusicKit identifier / App name shown during authorize
# Tokens: spotify_credentials (service=apple_music) | last-played: music_last_played (service=apple_music)
# -----------------------------------------------------------------------------
MUSIC_KIT_TEAM_ID=
MUSIC_KIT_KEY_ID=
MUSIC_KIT_PRIVATE_KEY=
MUSIC_KIT_ID=

# -----------------------------------------------------------------------------
# MongoDB (required for Spotify / YouTube Music / Apple Music token storage)
# Uses the syncapp database
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/syncapp

# -----------------------------------------------------------------------------
# SyncApp blog integration (server-side only)
# Fetches published posts from https://sync-app-server.vercel.app/api
# See SyncApp API Postman collection: Auth → Login, Posts → Get Posts
# -----------------------------------------------------------------------------

# API base URL (optional — defaults to production URL in prod, localhost:9000 in dev)
# SYNCAPP_API_URL=https://sync-app-server.vercel.app/api

# Option A: Bearer token from Postman {{token}} or SyncApp login response
# SYNCAPP_API_TOKEN=

# Option B: Login credentials (POST /auth/login)
# SYNCAPP_EMAIL=your@email.com
# SYNCAPP_PASSWORD=your_password

# -----------------------------------------------------------------------------
# Resend newsletter (server-side only)
# Get your API key at https://resend.com/api-keys
# Verify your domain in Resend before using a custom from address in production.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxx
# Sender for notification emails, e.g. Farukh Saifi <newsletter@farukh.me>
RESEND_FROM=newsletter@yourdomain.com

# Optional: Resend segment id for newsletter contacts
# RESEND_SEGMENT_ID=
# Where to receive new-subscriber notifications (defaults to ADMIN_EMAIL)
# NEWSLETTER_NOTIFY_EMAIL=farook1x95@gmail.com

# -----------------------------------------------------------------------------
# Admin / route protection (optional)
# Used by /api/authenticate for password-protected pages (see once-ui.config.ts)
# Note: RouteGuard currently sends password only; email defaults to ADMIN_EMAIL
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@farukh.me
ADMIN_PASSWORD=your-admin-password
